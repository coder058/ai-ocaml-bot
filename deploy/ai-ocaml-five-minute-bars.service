[Unit]
Description=Refresh Alpaca BTC/USD closed 5m bar snapshot for OCaml analysis
After=network-online.target
Wants=network-online.target
OnSuccess=ai-ocaml-markov-shadow.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/ocaml-paper-market-lab/research
ExecStart=/home/ubuntu/ocaml-paper-market-lab/.venv/bin/python /home/ubuntu/ocaml-paper-market-lab/research/refresh_five_minute_bars.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/jsbot-paper-state
