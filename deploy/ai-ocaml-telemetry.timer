[Unit]
Description=Check for new paper decisions and broker activity

[Timer]
# GUESS: # UNCALIBRATED GUESS — check every 15 seconds for order events;
# upload only on a material change or an idle heartbeat.
OnBootSec=15s
OnUnitActiveSec=15s
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
