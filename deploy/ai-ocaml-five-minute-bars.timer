[Unit]
Description=Refresh closed Alpaca BTC/USD 5m context repeatedly

[Timer]
# GUESS: # UNCALIBRATED GUESS — observed bar availability was <1s after
# the UTC five-minute close in two checks. Poll five seconds after each close
# to leave a margin, then retry at thirty seconds if the bar was late.
OnCalendar=*:0/5:05 UTC
OnCalendar=*:0/5:30 UTC
# GUESS: # UNCALIBRATED GUESS — reduce timer coalescing to one second so the
# as-observed prediction time stays close to the declared clock schedule.
AccuracySec=1s
Persistent=true
Unit=ai-ocaml-five-minute-bars.service

[Install]
WantedBy=timers.target
