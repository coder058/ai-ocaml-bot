[Unit]
Description=Read-only multi-timeframe crypto candle research
After=ai-ocaml-market-capture.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ocaml-paper-market-lab
ExecStart=/home/ubuntu/ocaml-paper-market-lab/.venv/bin/python /home/ubuntu/ocaml-paper-market-lab/research/multi_timeframe_shadow.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/jsbot-paper-state
