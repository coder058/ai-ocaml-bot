[Unit]
Description=Native closed-candle warmup and shared OCaml multi-market analysis
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=TZ=UTC
WorkingDirectory=/home/ubuntu/ocaml-paper-market-lab
ExecStart=/home/ubuntu/ocaml-paper-market-lab/.venv/bin/python research/market_pipeline.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/jsbot-paper-state
