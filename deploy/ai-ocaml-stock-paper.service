[Unit]
Description=AI OCaml Bot stocks ETF paper connection and reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Environment=TZ=UTC
Environment=PAPER_STATE_DIR=/home/ubuntu/jsbot-paper-state
# SOURCE: automatic policy remains in observation until execution-aware
# evaluation supports activation. No --execute argument is supplied here.
Environment=STOCK_PAPER_ORDERS=0
Environment=STOCK_AUTO_ORDERS=0
Environment=STOCK_AUTO_NEW_ENTRIES=0
EnvironmentFile=/etc/jsbot-paper.env
WorkingDirectory=/home/ubuntu/ocaml-paper-market-lab
ExecStart=/home/ubuntu/ocaml-paper-market-lab/_build/default/bin/stock_auto_main.exe
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/jsbot-paper-state
